#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"

// tap windows for ctl alt and gui

#define HM_TAPPING_TERM 250
#define HM_TAPPING_REPEAT 210

// quick tapping for shift

#define HM_TAPPING_TERM_FAST 200
#define HM_PRIOR_IDLE 70
#define BASE 0
#define WIN 1
#define LOWER 2
#define RAISE 3
#define ADJUST 4
#define NAVI   5
#define NUM    6
#define DEBUG  7

// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define THUMBS LH1 LH0 RH0 RH1
#define KEYS_T LH1 LH0 RH0 RH1
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    // Activate ADJUST layer by pressing raise and lower

    behaviors {
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;                // repeat on tap-into-hold
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;
            hold-trigger-on-release;
        };

        // Positional Homerow mods for shift
        // Use faster tapping term and disable some features that may
        // cause false negatives.

        hm_shift_l: hm_shift_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            //flavor = "balanced";

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R KEYS_T>;
            hold-trigger-on-release;
        };

        hm_shift_r: hm_shift_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM_FAST>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <HM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L KEYS_T>;

            // for quick tapping; shift+~

            hold-trigger-on-release;
        };

        /*
         * Non-Positional Homerow Mods
         * Used for &mm_grescm_gui behavior on left hand.
         *
         * Usage: &hm LSHFT T
         * Tap: T
         * Tap-Tap-Hold: Repeat T
         * Hold: LSHIFT
         */

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "hold-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            label = "Toggle Layer ON";
            #binding-cells = <1>;
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            label = "Toggle Layer OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <6 4>;
            then-layer = <7>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cb_ltm {
            bindings = <&kp ESC>;
            key-positions = <2 4>;
            layers = <0 2>;
        };

        cb_lm {
            bindings = <&kp TAB>;
            key-positions = <14 16>;
            layers = <0 2>;
        };

        cb_enter {
            bindings = <&kp RET>;
            key-positions = <21 19>;
            layers = <0 2>;
        };

        layer3 {
            bindings = <&kp N3>;
            key-positions = <5 6>;
        };

        layer4 {
            bindings = <&kp N4>;
            key-positions = <5 6>;
        };

        imput_parenthesis {
            bindings = <&imput_parenthesis>;
            key-positions = <9 10>;
        };
    };

    macros {
        imput_parenthesis: imput_parenthesis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "IMPUT_PARENTHESIS";
        };

        WinMode: WinMode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog_off 3>, <&macro_wait_time 100>, <&tog_on 1>;

            label = "WINMODE";
        };

        MacMode: MacMode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog_off 1>, <&macro_wait_time 100>, <&tog_on 3>;

            label = "MACMODE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base_layer {
            display-name = "Common layouts";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESCAPE        &kp Q          &kp W         &kp E         &kp R                &kp T                          &kp Y           &kp U                &kp I          &kp O         &kp P             &lt 6 MINUS
&mt CAPSLOCK TAB  &hm_l LCTRL A  &hm_l LALT S  &hm_l LGUI D  &hm_shift_l LSHFT F  &kp G                          &kp H           &hm_shift_r RSHFT J  &hm_r RGUI K   &hm_r RALT L  &hm_r RCTRL SEMI  &kp SLASH
&kp LEFT_SHIFT    &hm_l LGUI Z   &kp X         &kp C         &kp V                &kp B      &WinMode  &MacMode  &kp N           &kp M                &kp COMMA      &kp DOT       &kp UP            &mt RIGHT_SHIFT BACKSLASH
&kp LCTRL         &kp LEFT_WIN   &kp LEFT_ALT  &mo 5         &kp SPACE            &kp SPACE                      &kp LANG_HANJA  &kp ENTER            &kp BACKSPACE  &kp LEFT      &kp DOWN          &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        WindowsMode {
            bindings = <
&trans  &trans       &trans       &trans       &trans       &trans                              &trans          &trans  &trans  &trans  &mt RC(P) P  &trans
&trans  &mt LC(A) A  &mt LC(S) S  &mt LC(D) D  &mt LC(F) F  &trans                              &trans          &trans  &trans  &trans  &trans       &trans
&trans  &mt LC(Z) Z  &mt LC(X) X  &mt LC(C) C  &mt LC(V) V  &trans              &trans  &trans  &trans          &trans  &trans  &trans  &trans       &trans
&trans  &trans       &trans       &trans       &trans       &lt 2 LS(CAPSLOCK)                  &kp LANG_HANJA  &trans  &trans  &trans  &trans       &trans
            >;
        };

        Win_Numbers {
            display-name = "Win Numbers & Shortcuts";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&none           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4   &kp NUMBER_5                                     &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &none
&none           &none         &none         &none         &kp SEMICOLON  &kp MINUS                                        &kp EQUAL     &kp SQT       &none         &none         &none         &none
&kp LEFT_SHIFT  &none         &none         &none         &none          &none         &kp LG(LS(S))  &kp LC(LS(DELETE))  &none         &none         &none         &none         &none         &kp RIGHT_SHIFT
&none           &none         &none         &none         &trans         &mo 2                                            &none         &trans        &kp DELETE    &none         &none         &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        MacMode {
            bindings = <
&trans  &trans       &trans       &trans       &trans       &trans                          &trans          &trans  &trans  &trans  &mt RG(P) P  &trans
&trans  &mt LG(A) A  &mt LG(S) S  &mt LG(D) D  &mt LG(F) F  &trans                          &trans          &trans  &trans  &trans  &trans       &trans
&trans  &mt LG(Z) Z  &mt LG(X) X  &mt LG(C) C  &mt LG(V) V  &trans          &trans  &trans  &trans          &trans  &trans  &trans  &trans       &trans
&trans  &trans       &trans       &trans       &trans       &lt 4 CAPSLOCK                  &kp LANGUAGE_2  &trans  &trans  &trans  &trans       &trans
            >;
        };

        Mac_Numbers {
            display-name = "Mac Numbers & Shortcuts";

            // TODO: Some binds are waiting for shifted keycode support.
            // -------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&none           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4   &kp NUMBER_5                         &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &none
&none           &none         &none         &none         &kp SEMICOLON  &kp MINUS                            &kp EQUAL     &kp SQT       &none         &none         &none         &none
&kp LEFT_SHIFT  &none         &none         &none         &none          &none         &kp LG(LS(F4))  &none  &none         &none         &none         &none         &none         &kp RIGHT_SHIFT
&none           &none         &none         &none         &trans         &mo 4                                &none         &trans        &kp DELETE    &none         &none         &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        NumPad {
            display-name = "Numbers&Functions";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&none  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &kp TAB               &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MULTIPLY  &kp BACKSPACE
&none  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10                  &kp LEFT_PARENTHESIS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS     &kp RIGHT_PARENTHESIS
&none  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &trans  &trans  &kp EQUAL             &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_PLUS      &kp KP_DIVIDE
&none  &none    &none    &mo 5    &trans   &trans                   &kp DELETE            &trans           &trans           &kp KP_N0        &kp KP_DOT       &kp ENTER
            >;

            sensor-bindings =
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>,
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        system_settings {
            display-name = "Bluetooth&System";
            bindings = <
&bt BT_CLR    &none  &none  &none   &bootloader  &none                   &none   &none   &none   &none  &none  &mo 6
&bt BT_SEL 0  &none  &none  &none   &none        &none                   &none   &none   &none   &none  &none  &none
&bt BT_SEL 1  &none  &none  &none   &none        &none   &trans  &trans  &trans  &trans  &none   &none  &none  &none
&bt BT_SEL 2  &none  &none  &trans  &trans       &trans                  &none   &none   &trans  &none  &none  &none
            >;
        };
    };
};
